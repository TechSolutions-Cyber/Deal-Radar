# Copy to .env.local and fill in real values

# Marktguru API keys — NEVER expose in client code (see HEL-3, HEL-10)
MARKTGURU_API_KEY=your_marktguru_api_key_here
MARKTGURU_CLIENT_KEY=your_marktguru_client_key_here

# Supabase (for HEL-4 Auth + HEL-7 Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Push notifications and Web Push (for HEL-5)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@deal-radar.de
NEXT_PUBLIC_APP_URL=https://deal-radar-app.vercel.app

# Email notifications (Resend) — for HEL-5
RESEND_API_KEY=re_your_resend_api_key_here

# Cron job authentication — for HEL-5
CRON_SECRET=your_long_random_secret_for_cron_auth
